label start

say Sumi:
    "What should we do?"

choice "Go outside" -> outside
choice "Stay inside" -> inside


label outside

say Sumi:
    "Let's go outside!"

choice "Go Back" -> start

jump end


label inside

say Sumi:
    "Let's stay inside!"

say Sumi:
    "Uhh wanna go back?"

choice "Go back" -> start

jump end


label end
